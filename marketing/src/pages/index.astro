---
import Layout from '../layouts/Layout.astro';
---

<Layout title="ASCEND - Level Up Your Reality">
    <header class="fixed top-0 w-full z-50 bg-background/80 backdrop-blur-xl border-b border-white/5 shadow-[0_4px_30px_rgba(18,5,38,0.5)]">
    <div class="flex justify-between items-center px-margin-safe py-4 max-w-container-max mx-auto">
    <div class="flex items-center gap-4">
    <img alt="ASCEND Logo" class="h-10 w-auto" src="https://lh3.googleusercontent.com/aida-public/AB6AXuDxA-HhzdJSp-Mz1WMHdz4p-8ZUHvcHWcwj5J9kYLrmGRB3Z_6Vo4kO6Gqnu0lTfM6F3CKWuWDTvB3b-D9ncB7062WgMRENAkuWCqMb2-deKK1m3CeucQKxB7LOmACcxzS95YzoJgnCOGQFvcDCe1krQNkKl57fGiw8NrslzbZtSdJI60nLdyErAR8P06VCxEe0tB4jY6C0vsKLAj_5AaTG6-St2P7hrGH4EUQNZRtmQCMQHmVIlv15koLZWiaWnHAby-r2Wnj2xJ_0"/>
    <span class="text-headline-md font-headline-md font-bold tracking-tighter text-primary drop-shadow-[0_0_10px_rgba(214,186,255,0.5)]">ASCEND</span>
    </div>
    <nav class="hidden md:flex items-center gap-8">
    <a class="font-label-md text-label-md text-on-surface-variant font-medium hover:text-primary transition-colors duration-300" href="#features">Features</a>
    <a class="font-label-md text-label-md text-on-surface-variant font-medium hover:text-primary transition-colors duration-300" href="#showcase">Showcase</a>
    <a class="font-label-md text-label-md text-primary font-bold border-b-2 border-primary pb-1 Active: scale-95 transition-transform hover:text-primary transition-colors duration-300" href="#download">Download</a>
    </nav>
    <button class="hidden md:block btn-primary-gradient px-6 py-3 rounded-full font-label-md text-label-md text-pure-white font-bold tracking-wider" onclick="document.getElementById('download').scrollIntoView({behavior: 'smooth'})">
                    Download Now
                </button>
    <button class="md:hidden text-primary">
    <span class="material-symbols-outlined" style="font-size: 32px;">menu</span>
    </button>
    </div>
    </header>
    <main class="flex-grow pt-32">
    <section class="relative min-h-[90vh] flex items-center justify-center px-margin-safe py-section-gap overflow-hidden animate-fade-in-up">
    <div class="absolute inset-0 z-0 opacity-40 mix-blend-screen pointer-events-none"></div>
    <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_center,_var(--tw-gradient-stops))] from-void-purple via-black to-black -z-10"></div>
    <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[800px] h-[800px] bg-primary/10 rounded-full blur-[120px] -z-10"></div>
    <div class="max-w-container-max mx-auto grid grid-cols-1 lg:grid-cols-2 gap-12 items-center relative z-10">
    <div class="space-y-8 text-center lg:text-left">
    <h1 class="font-display-lg-mobile md:font-display-lg text-display-lg-mobile md:text-display-lg text-pure-white drop-shadow-[0_0_20px_rgba(214,186,255,0.3)]">
                            ASCEND YOUR <br/>
    <span class="text-transparent bg-clip-text bg-gradient-to-r from-primary to-inverse-primary">LIFE</span>
    </h1>
    <p class="font-body-lg text-body-lg text-on-surface-variant max-w-xl mx-auto lg:mx-0">
                            The premium Life RPG that turns your daily routines into an epic quest. Forge your destiny, master your skills, and conquer the ultimate game: your life. Download the app today.
                        </p>
    <div class="pt-4 flex flex-col sm:flex-row gap-4 justify-center lg:justify-start">
    <button class="btn-primary-gradient px-8 py-4 rounded-full font-label-md text-label-md text-pure-white font-bold tracking-wider uppercase inline-flex items-center justify-center gap-2" onclick="document.getElementById('download').scrollIntoView({behavior: 'smooth'})">
                                Download the App
                                <span class="material-symbols-outlined" style="font-variation-settings: 'FILL' 1;">download</span>
    </button>
    </div>
    </div>
    <div class="relative flex justify-center items-center crystal-float mt-12 lg:mt-0">
    <img alt="Ascend App Mockup on a sleek smartphone, glowing with purple neon energy, surrounded by floating crystalline structures in a dark void space." class="w-full max-w-md z-20 relative drop-shadow-[0_0_40px_rgba(120,50,217,0.6)] rounded-2xl" src="https://lh3.googleusercontent.com/aida/AP1WRLvrLmTGOHapaIesWXda0JJOVU72gi5DAR3tKL_LnI7o5jVyX_jAMRHoJI8s8y7C80gz-Eg3bySVpPc4HJkwc3hax4dABY_7_UZ4qDdtoUTZ6J6JJJenz9ZNiN87BD7PHbphItubmrlohg_gpe0qLsqkvD_su0_WE7GI-f-i27p-B22b956Vtq1xcKN9lxZKNG61fk7M-WvXJx1rpf3qWLIxWczk6MPK30EL8-UtJl55JY61enfWp_ylo644"/>
    <div class="absolute inset-0 border border-primary/20 rounded-full animate-[spin_20s_linear_infinite] scale-[1.2] -z-10"></div>
    <div class="absolute inset-0 border border-primary/10 rounded-full animate-[spin_15s_linear_infinite_reverse] scale-[1.5] -z-10"></div>
    </div>
    </div>
    </section>
    <section class="py-section-gap px-margin-safe relative animate-fade-in-up delay-100" id="features">
    <div class="max-w-container-max mx-auto">
    <div class="text-center mb-16">
    <h2 class="font-headline-lg text-headline-lg text-pure-white mb-4">Inside the ASCEND Interface</h2>
    <p class="font-body-lg text-body-lg text-on-surface-variant max-w-2xl mx-auto">A visual tour of the premium tools designed to help you master every facet of your existence.</p>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
    <div class="glass-panel p-8 rounded-lg scanline-hover group">
    <div class="h-16 w-16 rounded-full bg-void-purple border border-primary flex items-center justify-center mb-6 group-hover:neon-glow transition-all">
    <span class="material-symbols-outlined text-primary text-3xl">task_alt</span>
    </div>
    <h3 class="font-headline-md text-headline-md text-pure-white mb-4">Quest Tracking UI</h3>
    <p class="font-body-md text-body-md text-on-surface-variant mb-6">Experience our intuitive log interface that transforms mundane chores into high-yield quests.</p>
    <div class="bg-surface-container-high rounded p-4 space-y-3 border border-white/5">
    <div class="flex items-center gap-3">
    <div class="w-4 h-4 rounded-sm border border-primary"></div>
    <span class="font-body-md text-body-md text-on-surface text-sm">Morning Protocol</span>
    <span class="ml-auto text-primary text-xs font-label-md">+50 XP</span>
    </div>
    <div class="flex items-center gap-3 opacity-50">
    <div class="w-4 h-4 rounded-sm bg-primary border border-primary flex items-center justify-center"><span class="material-symbols-outlined text-void-purple" style="font-size: 12px; font-variation-settings: 'FILL' 1;">check</span></div>
    <span class="font-body-md text-body-md text-on-surface text-sm line-through">Deep Work Sprint</span>
    </div>
    </div>
    </div>
    <div class="glass-panel p-8 rounded-lg scanline-hover group relative overflow-hidden">
    <div class="absolute top-0 right-0 w-32 h-32 bg-primary/10 rounded-bl-full blur-2xl"></div>
    <div class="h-16 w-16 rounded-full bg-void-purple border border-primary flex items-center justify-center mb-6 group-hover:neon-glow transition-all relative z-10">
    <span class="material-symbols-outlined text-primary text-3xl" style="font-variation-settings: 'FILL' 1;">star</span>
    </div>
    <h3 class="font-headline-md text-headline-md text-pure-white mb-4 relative z-10">Skill Tree Progression</h3>
    <p class="font-body-md text-body-md text-on-surface-variant mb-6 relative z-10">Visualize your proficiency across designated life domains with our dynamic progress bars.</p>
    <div class="space-y-2 mt-auto relative z-10">
    <div class="flex justify-between text-xs font-label-md">
    <span class="text-pure-white">Focus Mastery</span>
    <span class="text-primary">Lvl 12</span>
    </div>
    <div class="h-2 w-full bg-void-purple rounded-full overflow-hidden relative border border-white/10">
    <div class="absolute top-0 left-0 h-full w-[75%] bg-primary shadow-[0_0_10px_rgba(214,186,255,0.8)]"></div>
    <div class="absolute top-0 left-[75%] w-4 h-full bg-pure-white blur-[2px] -translate-x-1/2"></div>
    </div>
    </div>
    </div>
    <div class="glass-panel p-8 rounded-lg scanline-hover group flex flex-col items-center text-center">
    <div class="mb-6 h-32 w-32 relative">
    <img alt="Collection of floating 3D icons: XP crystal, achievement badge, and streak fire." class="w-full h-full object-contain crystal-float" src="https://lh3.googleusercontent.com/aida/AP1WRLtMEjoetpbxZZn_LQ2YR-v_PAb82iIkJcDy7rOgKvDtXSwTHKv5j5MD1BwSGerqN1StO8LCeme9lhQWg0Pq-5zU7SfnENaBdP7RCCS4aZoiv8bMfzvR6hLniRZF-YJWf8WwZr8J5l0jJzYv1wi5ekYIAJZdBD-GC-UNqRM04mr2PkR5mNR3thjJL-vxYOyaE2oc0UuVuw4ouP3Pf7-pUXR_sWz30psfDvuctU94CT4s3KBqZsXQ4hkSoOHS"/>
    </div>
    <h3 class="font-headline-md text-headline-md text-pure-white mb-4">Premium Artifacts</h3>
    <p class="font-body-md text-body-md text-on-surface-variant">Collect beautifully rendered 3D badges, XP crystals, and streak multipliers as you chain successful days.</p>
    </div>
    </div>
    </div>
    </section>
    <section class="py-section-gap px-margin-safe bg-surface-container-lowest/50 border-y border-white/5 relative animate-fade-in-up delay-200" id="showcase">
    <div class="absolute top-1/2 left-0 w-1/3 h-full bg-primary/5 blur-[100px] -translate-y-1/2"></div>
    <div class="max-w-container-max mx-auto relative z-10">
    <h2 class="font-headline-lg text-headline-lg text-pure-white text-center mb-16">Ascended Players</h2>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
    <div class="glass-panel p-8 rounded-lg flex gap-6 items-start">
    <div class="relative shrink-0">
    <div class="w-16 h-16 rounded-full bg-surface-bright overflow-hidden border-2 border-primary neon-glow">
    <div class="w-full h-full bg-gradient-to-br from-void-purple to-secondary-container"></div>
    </div>
    <div class="absolute -bottom-2 -right-2 bg-void-purple border border-primary text-primary text-[10px] font-bold px-2 py-1 rounded">Lvl 42</div>
    </div>
    <div>
    <p class="font-body-md text-body-md text-pure-white italic mb-4">"Ascend completely rewired my dopamine circuits. Doing laundry now feels like grinding for epic gear. My productivity is unmatched."</p>
    <p class="font-label-md text-label-md text-primary uppercase tracking-widest">Cipher_X // <span class="text-on-surface-variant">Grandmaster</span></p>
    </div>
    </div>
    <div class="glass-panel p-8 rounded-lg flex gap-6 items-start">
    <div class="relative shrink-0">
    <div class="w-16 h-16 rounded-full bg-surface-bright overflow-hidden border-2 border-primary neon-glow">
    <div class="w-full h-full bg-gradient-to-br from-primary-container to-void-purple"></div>
    </div>
    <div class="absolute -bottom-2 -right-2 bg-void-purple border border-primary text-primary text-[10px] font-bold px-2 py-1 rounded">Lvl 38</div>
    </div>
    <div>
    <p class="font-body-md text-body-md text-pure-white italic mb-4">"The void aesthetic and neon progress bars make checking off my fitness goals intensely satisfying. I'm actually addicted to improving my real life."</p>
    <p class="font-label-md text-label-md text-primary uppercase tracking-widest">Nova_Prime // <span class="text-on-surface-variant">Elite Vanguard</span></p>
    </div>
    </div>
    </div>
    </div>
    </section>
    <section class="py-section-gap px-margin-safe relative animate-fade-in-up delay-300" id="download">
    <div class="max-w-4xl mx-auto text-center glass-panel p-12 md:p-20 rounded-2xl relative overflow-hidden">
    <div class="absolute inset-0 bg-gradient-to-b from-primary/10 to-transparent -z-10"></div>
    <h2 class="font-headline-lg text-headline-lg text-pure-white mb-6 drop-shadow-[0_0_15px_rgba(214,186,255,0.4)]">Begin Your Journey</h2>
    <p class="font-body-lg text-body-lg text-on-surface-variant mb-12 max-w-xl mx-auto">Download the ASCEND app now and transform your reality. Available directly as an Android APK.</p>
    <div class="flex flex-col sm:flex-row justify-center items-center gap-6">
    <a class="btn-primary-gradient px-10 py-4 rounded-xl flex items-center gap-4 w-full sm:w-auto justify-center hover:scale-105 transition-transform" href="https://github.com/jayakrishnanps/Ascent/releases/download/v1.0.0/Ascend-v1.0.apk">
    <span class="material-symbols-outlined text-3xl text-pure-white">android</span>
    <div class="text-left text-pure-white">
    <div class="text-[10px] uppercase tracking-wider opacity-80 font-label-md">Direct Download</div>
    <div class="font-bold text-xl leading-tight font-headline-md">Android APK</div>
    </div>
    </a>
    </div>
    </div>
    </section>
    </main>
    <footer class="w-full py-section-gap bg-background border-t border-white/5">
    <div class="flex flex-col md:flex-row justify-between items-center px-margin-safe max-w-container-max mx-auto gap-8">
    <div class="text-headline-md font-headline-md text-primary drop-shadow-[0_0_10px_rgba(214,186,255,0.5)]">
                    ASCEND
                </div>
    <div class="flex flex-wrap justify-center gap-6">
    <a class="font-body-md text-body-md text-on-surface-variant hover:text-lavender-tint transition-all hover:opacity-80" href="#">Privacy Protocol</a>
    <a class="font-body-md text-body-md text-on-surface-variant hover:text-lavender-tint transition-all hover:opacity-80" href="#">Terms of Service</a>
    <a class="font-body-md text-body-md text-on-surface-variant hover:text-lavender-tint transition-all hover:opacity-80" href="#">Command Center</a>
    </div>
    <div class="font-body-md text-body-md text-on-surface-variant text-sm">
                    © 2024 ASCEND. LEVEL UP YOUR REALITY.
                </div>
    </div>
    </footer>
</Layout>
