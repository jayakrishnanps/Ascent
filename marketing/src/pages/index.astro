---
import Layout from '../layouts/Layout.astro';
---

<Layout title="ASCENT - Level Up Your Reality">
    <header class="fixed top-0 w-full z-50 bg-black border-b border-white/10 shadow-2xl">
    <div class="flex justify-between items-center px-margin-safe py-4 max-w-container-max mx-auto">
    <div class="flex items-center gap-4">
    <img alt="ASCENT Logo" class="h-10 w-auto" src="/Ascent/logo.png"/>
    <span class="text-headline-md font-headline-md font-bold tracking-tighter text-primary drop-shadow-[0_0_10px_rgba(214,186,255,0.5)]">ASCENT</span>
    </div>
    <nav class="hidden md:flex items-center gap-8">
    <a class="font-label-md text-label-md text-on-surface-variant font-medium hover:text-primary transition-colors duration-300" href="#features">Features</a>
    <a class="font-label-md text-label-md text-primary font-bold border-b-2 border-primary pb-1 Active: scale-95 transition-transform hover:text-primary transition-colors duration-300" href="#download">Download</a>
    </nav>
    <button class="hidden md:block btn-primary-gradient px-6 py-3 rounded-full font-label-md text-label-md text-pure-white font-bold tracking-wider" onclick="document.getElementById('download').scrollIntoView({behavior: 'smooth'})">
                    Download Now
                </button>
    <button class="md:hidden text-primary">
    <span class="material-symbols-outlined" style="font-size: 32px;">menu</span>
    </button>
    </div>
    </header>
    <main class="flex-grow pt-32">
    <section class="relative min-h-[90vh] flex items-center justify-center px-margin-safe py-section-gap overflow-hidden animate-fade-in-up">
    <div class="absolute inset-0 z-0 opacity-40 mix-blend-screen pointer-events-none"></div>
    <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_center,_var(--tw-gradient-stops))] from-void-purple via-black to-black -z-10"></div>
    <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[800px] h-[800px] bg-primary/10 rounded-full blur-[120px] -z-10"></div>
    <div class="max-w-container-max mx-auto flex flex-col items-center justify-center relative z-10 text-center">
    <div class="max-w-3xl flex flex-col items-center">
    
    <div class="relative flex justify-center items-center crystal-float w-48 h-48 md:w-64 md:h-64 mb-12">
    <img alt="ASCENT Official Logo" class="w-full h-full z-20 relative drop-shadow-[0_0_60px_rgba(120,50,217,0.9)]" src="/Ascent/logo.png"/>
    <div class="absolute inset-0 border-2 border-primary/30 rounded-full animate-[spin_20s_linear_infinite] scale-[1.3] -z-10"></div>
    <div class="absolute inset-0 border border-primary/20 rounded-full animate-[spin_15s_linear_infinite_reverse] scale-[1.6] -z-10"></div>
    </div>

    <div class="space-y-8 text-center">
    <h1 class="font-display-lg-mobile md:font-display-lg text-display-lg-mobile md:text-display-lg text-pure-white drop-shadow-[0_0_20px_rgba(214,186,255,0.3)] leading-tight">
                            ASCENT YOUR <br/>
    <span class="text-transparent bg-clip-text bg-gradient-to-r from-primary via-inverse-primary to-primary bg-[length:200%_auto] animate-[gradient_3s_linear_infinite]">LIFE</span>
    </h1>
    <p class="font-body-lg text-body-lg text-on-surface-variant mx-auto max-w-2xl leading-relaxed">
                            The premium Life RPG that turns your daily routines into an epic quest. Forge your destiny, master your skills, and conquer the ultimate game: your life. Download the app today.
                        </p>
    <div class="pt-6 flex flex-col sm:flex-row gap-4 justify-center">
    <button class="btn-primary-gradient px-10 py-5 rounded-full font-label-md text-label-md text-pure-white font-bold tracking-widest uppercase inline-flex items-center justify-center gap-3 hover:scale-105 transition-all shadow-[0_0_30px_rgba(120,50,217,0.5)]" onclick="document.getElementById('download').scrollIntoView({behavior: 'smooth'})">
                                Download the App
                                <span class="material-symbols-outlined" style="font-variation-settings: 'FILL' 1;">download</span>
    </button>
    </div>
    </div>
    </div>
    </div>
    </section>
    <section class="py-section-gap px-margin-safe relative animate-fade-in-up delay-100 bg-gradient-to-b from-black to-[#131313]" id="features">
    <div class="max-w-container-max mx-auto relative z-10">
    <div class="text-center mb-16">
    <h2 class="font-headline-lg text-headline-lg text-pure-white mb-4">Inside the ASCENT Interface</h2>
    <p class="font-body-lg text-body-lg text-on-surface-variant max-w-2xl mx-auto">A visual tour of the premium tools designed to help you master every facet of your existence.</p>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8 max-w-4xl mx-auto">
    <div class="glass-panel scanline-hover p-8 rounded-2xl border border-primary/20 bg-void-purple/20 backdrop-blur-xl shadow-[0_8px_30px_rgb(0,0,0,0.5)] hover:border-primary/50 hover:shadow-[0_0_40px_rgba(120,50,217,0.3)] transition-all duration-300 group relative overflow-hidden transform hover:-translate-y-1">
    <div class="absolute top-0 right-0 w-48 h-48 bg-primary/5 rounded-bl-full blur-2xl -z-10 group-hover:bg-primary/10 transition-colors duration-300"></div>
    <div class="h-16 w-16 rounded-2xl bg-void-purple border border-primary/30 flex items-center justify-center mb-8 group-hover:border-primary transition-all duration-300 shadow-[inset_0_0_15px_rgba(120,50,217,0.2)]">
    <span class="material-symbols-outlined text-primary text-3xl">task_alt</span>
    </div>
    <h3 class="font-headline-md text-headline-md text-pure-white mb-4 tracking-wide uppercase text-sm font-bold">Quest Log</h3>
    <p class="font-body-md text-body-md text-on-surface-variant mb-8 opacity-90">Transform daily chores into high-yield quests with our intuitive log interface.</p>
    <div class="bg-surface-container-high/60 rounded-xl p-5 space-y-4 border border-white/5 relative">
    <div class="absolute left-0 top-0 bottom-0 w-1 bg-gradient-to-b from-primary to-transparent rounded-l-xl"></div>
    <div class="flex items-center gap-4">
    <div class="w-5 h-5 rounded-md border-2 border-primary/60 flex-shrink-0"></div>
    <span class="font-body-md text-body-md text-on-surface text-sm font-medium">Morning Protocol</span>
    <span class="ml-auto text-primary text-xs font-label-md font-bold bg-primary/10 px-2 py-1 rounded">+50 EXP</span>
    </div>
    <div class="flex items-center gap-4 opacity-50">
    <div class="w-5 h-5 rounded-md bg-primary/80 border-2 border-primary flex items-center justify-center flex-shrink-0"><span class="material-symbols-outlined text-background" style="font-size: 14px; font-variation-settings: 'FILL' 1;">check</span></div>
    <span class="font-body-md text-body-md text-on-surface text-sm line-through decoration-primary/50">Deep Work Sprint</span>
    </div>
    </div>
    </div>
    <div class="glass-panel scanline-hover p-8 rounded-2xl border border-secondary/20 bg-void-purple/20 backdrop-blur-xl shadow-[0_8px_30px_rgb(0,0,0,0.5)] hover:border-secondary/50 hover:shadow-[0_0_40px_rgba(214,186,255,0.3)] transition-all duration-300 group relative overflow-hidden transform hover:-translate-y-1">
    <div class="absolute top-0 right-0 w-48 h-48 bg-secondary/5 rounded-bl-full blur-2xl -z-10 group-hover:bg-secondary/10 transition-colors duration-300"></div>
    <div class="h-16 w-16 rounded-2xl bg-void-purple border border-secondary/30 flex items-center justify-center mb-8 group-hover:border-secondary transition-all duration-300 shadow-[inset_0_0_15px_rgba(214,186,255,0.2)] relative z-10">
    <span class="material-symbols-outlined text-secondary text-3xl" style="font-variation-settings: 'FILL' 1;">star</span>
    </div>
    <h3 class="font-headline-md text-headline-md text-pure-white mb-4 tracking-wide uppercase text-sm font-bold relative z-10">Skill Tree</h3>
    <p class="font-body-md text-body-md text-on-surface-variant mb-8 opacity-90 relative z-10">Visualize your proficiency across life domains with dynamic progress tracking.</p>
    <div class="space-y-3 mt-auto relative z-10 bg-surface-container-high/60 p-5 rounded-xl border border-white/5">
    <div class="flex justify-between text-xs font-label-md items-end">
    <span class="text-pure-white font-medium">Focus Mastery</span>
    <span class="text-secondary font-bold text-sm">Lvl 12</span>
    </div>
    <div class="h-2.5 w-full bg-background rounded-full overflow-hidden relative border border-white/5 shadow-inner">
    <div class="absolute top-0 left-0 h-full w-[75%] bg-gradient-to-r from-primary to-secondary shadow-[0_0_10px_rgba(214,186,255,0.5)]"></div>
    </div>
    <div class="flex justify-between text-[10px] text-on-surface-variant/50 uppercase tracking-widest mt-1">
    <span>Exp 4,500</span>
    <span>6,000 Next</span>
    </div>
    </div>
    </div>

    </section>
    <section class="py-section-gap px-margin-safe relative animate-fade-in-up delay-300" id="download">
    <div class="max-w-4xl mx-auto text-center glass-panel p-12 md:p-20 rounded-2xl relative overflow-hidden bg-void-purple/10 backdrop-blur-xl border border-white/10 hover:shadow-[0_0_50px_rgba(120,50,217,0.2)] transition-shadow duration-700">
    <div class="absolute inset-0 bg-gradient-to-b from-primary/10 to-transparent -z-10"></div>
    <h2 class="font-headline-lg text-headline-lg font-bold mb-6 drop-shadow-[0_0_15px_rgba(214,186,255,0.4)] text-transparent bg-clip-text bg-gradient-to-r from-pure-white via-primary to-pure-white bg-[length:200%_auto] animate-text-shimmer">Begin Your Journey</h2>
    <p class="font-body-lg text-body-lg text-on-surface-variant mb-12 max-w-xl mx-auto">Download the ASCENT app now and transform your reality. Available directly as an Android APK.</p>
    <div class="flex flex-col sm:flex-row justify-center items-center gap-6">
    <a class="relative group px-10 py-5 rounded-2xl flex items-center gap-4 w-full sm:w-auto justify-center hover:scale-105 transition-transform overflow-hidden shadow-[0_0_30px_rgba(120,50,217,0.3)] hover:shadow-[0_0_40px_rgba(120,50,217,0.6)]" href="https://github.com/jayakrishnanps/Ascent/releases/download/v1.0.0/Ascent-v1.0.apk">
    <div class="absolute inset-0 bg-gradient-to-br from-primary via-inverse-primary to-void-purple z-0 group-hover:opacity-90 transition-opacity"></div>
    <div class="absolute inset-0 border border-white/20 rounded-2xl z-10"></div>
    <div class="absolute inset-0 shadow-[inset_0_0_20px_rgba(255,255,255,0.15)] rounded-2xl z-10 pointer-events-none"></div>
    <span class="material-symbols-outlined text-3xl text-pure-white relative z-20">android</span>
    <div class="text-left text-pure-white relative z-20">
    <div class="text-[10px] uppercase tracking-widest opacity-90 font-label-md font-bold text-pure-white drop-shadow-md">Direct Download</div>
    <div class="font-bold text-xl leading-tight font-headline-md tracking-wide">Android APK</div>
    </div>
    </a>
    </div>
    </div>
    </section>
    </main>
    <footer class="w-full py-8 bg-black border-t border-white/10 mt-20">
    <div class="flex justify-between items-center px-margin-safe max-w-container-max mx-auto">
    <div class="flex items-center gap-3">
    <img alt="ASCENT Logo" class="h-6 w-auto" src="/Ascent/logo.png"/>
    <span class="text-sm font-headline-md font-bold text-primary">ASCENT</span>
    </div>
    <div class="font-body-md text-on-surface-variant text-sm">
                    © 2024 ASCENT
                </div>
    </div>
    </footer>
</Layout>
